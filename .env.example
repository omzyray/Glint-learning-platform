# Clerk – https://dashboard.clerk.com/
# Get these from your Clerk application (app_3IEMb6tHiPi0wLdJGab51zvd5ln) or use the keyless dev keys in .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routing – created by `clerk init`
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity – https://www.sanity.io/manage
# Public dataset coordinates (client-safe, used by the Studio and image builder)
NEXT_PUBLIC_SANITY_PROJECT_ID=cgcaxwb9
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-22

# Server-only read token for the private dataset (never prefix with NEXT_PUBLIC).
# Create at Sanity Manage → Project → API → Tokens (Viewer role) or:
#   npx sanity tokens add "Glint web read" --role=viewer --yes --json
# Required for all web-app content fetches (catalog, course, lesson, instructor, category).
# The token is consumed only in server-only modules (sanity/lib/serverClient.ts, sanity/lib/live.ts)
# and is never exposed to the browser.
SANITY_API_READ_TOKEN=

# Optional write token (Editor) for server routes that mutate progress.
# Keep server-only; never expose to the browser.
SANITY_API_WRITE_TOKEN=
